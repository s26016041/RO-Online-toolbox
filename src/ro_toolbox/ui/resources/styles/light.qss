/* RO Online Toolbox — 淺色主題（預設） */

QWidget {
    background-color: #ffffff;
    color: #1f2328;
    font-family: "Microsoft JhengHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow::separator {
    background: #e3e5e8;
    height: 1px;
}

/* ---- 側欄 ---- */
QListWidget#sidebar {
    background-color: #f5f6f8;
    border: none;
    border-right: 1px solid #e3e5e8;
    padding: 8px 6px;
    outline: 0;
}

QListWidget#sidebar::item {
    padding-left: 14px;
    border-radius: 6px;
    color: #5c6570;
}

QListWidget#sidebar::item:hover {
    background-color: #e8eaee;
    color: #1f2328;
}

QListWidget#sidebar::item:selected {
    background-color: #dbe6fb;
    color: #14406f;
}

/* ---- 頁面 ---- */
QLabel#pageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #11161c;
}

QLabel#pageSubtitle {
    color: #656d76;
}

QLabel#placeholder {
    color: #8b939c;
    border: 1px dashed #d5d8dd;
    border-radius: 8px;
    padding: 28px;
}

QLabel#cardTitle {
    font-size: 16px;
    font-weight: 600;
    color: #11161c;
}

/* ---- 按鈕 ---- */
QPushButton {
    background-color: #f6f7f9;
    border: 1px solid #d0d4da;
    border-radius: 6px;
    padding: 7px 18px;
    color: #24292f;
}

QPushButton:hover  { background-color: #eceef2; }
QPushButton:pressed { background-color: #e0e3e8; }
QPushButton:disabled {
    color: #a6adb5;
    background-color: #f6f7f9;
    border-color: #e3e5e8;
}

QPushButton#primaryButton {
    background-color: #2f6feb;
    border-color: #2c66d8;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primaryButton:hover  { background-color: #3b7bf5; }
QPushButton#primaryButton:pressed { background-color: #2559c4; }
QPushButton#primaryButton:disabled {
    background-color: #b9cdf5;
    border-color: #b9cdf5;
    color: #ffffff;
}

/* ---- 日誌面板 ---- */
QDockWidget {
    titlebar-close-icon: none;
    color: #656d76;
}

QDockWidget::title {
    background: #f5f6f8;
    padding: 6px 10px;
    border-top: 1px solid #e3e5e8;
}

QPlainTextEdit#logView {
    background-color: #fbfcfd;
    border: none;
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 12px;
    padding: 6px;
    color: #24292f;
}

/* ---- 選單 / 狀態列 ---- */
QMenuBar {
    background-color: #f5f6f8;
    border-bottom: 1px solid #e3e5e8;
}

QMenuBar::item:selected { background: #dbe6fb; }

QMenu {
    background-color: #ffffff;
    border: 1px solid #d5d8dd;
}

QMenu::item:selected { background-color: #dbe6fb; }

QStatusBar {
    background-color: #f5f6f8;
    border-top: 1px solid #e3e5e8;
    color: #656d76;
}

/* ---- 捲軸 ---- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c9ced6;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover { background: #b2b9c2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

/* ---- 提示條 ---- */
QLabel#notice {
    background-color: #fff6e0;
    border: 1px solid #f0d190;
    border-radius: 6px;
    color: #7a5610;
    padding: 9px 12px;
}

QLabel#infoBar {
    background-color: #eef4fd;
    border: 1px solid #c4d9f7;
    border-radius: 6px;
    color: #2b4f7d;
    padding: 9px 12px;
}

/* ---- 下拉選單 / 輸入框 ---- */
QComboBox, QLineEdit {
    background-color: #ffffff;
    border: 1px solid #d0d4da;
    border-radius: 5px;
    padding: 5px 10px;
    color: #24292f;
}

QComboBox:hover, QLineEdit:hover { border-color: #b6bcc5; }
QLineEdit:focus, QComboBox:focus { border-color: #2f6feb; }
QComboBox:disabled, QLineEdit:disabled {
    color: #a6adb5;
    background-color: #f6f7f9;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d5d8dd;
    selection-background-color: #dbe6fb;
    selection-color: #14406f;
    outline: 0;
}

/* ---- 核取方塊 ---- */
QCheckBox { spacing: 7px; }
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #c2c8d0;
    border-radius: 3px;
    background: #ffffff;
}
QCheckBox::indicator:checked {
    background: #2f6feb;
    border-color: #2c66d8;
}

/* ---- 表格 ---- */
QTableView, QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #fafbfc;
    border: 1px solid #e3e5e8;
    border-radius: 6px;
    gridline-color: #eceef1;
    selection-background-color: #dbe6fb;
    selection-color: #14406f;
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 12px;
}

QTableView::item, QTableWidget::item { padding: 3px 6px; }

QHeaderView::section {
    background-color: #f5f6f8;
    border: none;
    border-right: 1px solid #e3e5e8;
    border-bottom: 1px solid #e3e5e8;
    color: #57606a;
    padding: 6px 8px;
}

/* ---- Hex 檢視 ---- */
QPlainTextEdit#hexView {
    background-color: #fbfcfd;
    border: 1px solid #e3e5e8;
    border-radius: 6px;
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 12px;
    padding: 8px;
    color: #24292f;
}

QSplitter::handle { background: #e3e5e8; height: 4px; }
QSplitter::handle:hover { background: #2f6feb; }

/* ---- 進度條 ---- */
QProgressBar {
    background-color: #eef0f3;
    border: 1px solid #dfe2e6;
    border-radius: 5px;
    text-align: center;
    color: #24292f;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #2f6feb;
    border-radius: 4px;
}

QProgressBar#hpBar::chunk { background-color: #3fa45b; }
QProgressBar#spBar::chunk { background-color: #4c8dd9; }

/* ---- 經驗條：細銀條 ----
   背景是白的，純銀 (#c0c0c0) 會糊掉，所以用「亮面→暗芯→反光」的金屬漸層，
   暗芯壓到中灰才看得出來。Base 走冷銀（偏藍）、Job 走暖銀（偏灰），
   兩條並排時分得出來，但都還在銀白系。 */
QLabel#expHead {
    font-weight: 600;
    color: #24292f;
}

QLabel#expValue {
    font-size: 11px;
    color: #656d76;
}

QProgressBar#baseBar,
QProgressBar#jobBar {
    background-color: #e9ecf1;
    border: 1px solid #cfd5de;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    padding: 0px;
}

QProgressBar#baseBar::chunk {
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #eef2f8, stop:0.35 #a6b3c6, stop:0.6 #74849c, stop:1 #9fadc0);
}

QProgressBar#jobBar::chunk {
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f6f4f0, stop:0.35 #c6c0b6, stop:0.6 #8f8880, stop:1 #b5aea5);
}

/* ---- 自動掛機的角色分頁 ---- */
QTabWidget#farmTabs::pane {
    border: 1px solid #e3e5e8;
    border-radius: 6px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: #f2f3f6;
    border: 1px solid #e3e5e8;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
    margin-right: 2px;
    color: #57606a;
}

QTabBar::tab:hover { background: #e8eaee; }

QTabBar::tab:selected {
    background: #ffffff;
    color: #14406f;
    font-weight: 600;
}
